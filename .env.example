# Site Base URL
NEXT_PUBLIC_SITE_URL=https://utilitech.in

# Admin Authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Neon Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require

# --------------------------------------------------------------------------
# Airpay Payment Gateway Integration
# --------------------------------------------------------------------------
# Environment mode: 'test' for Airpay Staging / Sandbox, 'production' for Live
AIRPAY_MODE=test

# Airpay Merchant Credentials (obtained from Airpay Merchant Portal)
AIRPAY_MERCHANT_ID=your_airpay_merchant_id
AIRPAY_USERNAME=your_airpay_username
AIRPAY_PASSWORD=your_airpay_password
AIRPAY_SECRET_KEY=your_airpay_secret_key

# Optional: Private Key (if explicitly given by Airpay, otherwise auto-computed)
AIRPAY_PRIVATE_KEY=

# Gateway URL (defaults to https://payments.airpay.co.in/pay/index.php)
# For Airpay Guru staging: https://payments.airpay.guru/pay/index.php
AIRPAY_GATEWAY_URL=https://payments.airpay.co.in/pay/index.php

# Allow simulation when test credentials are used or keys are pending
AIRPAY_ENABLE_SIMULATION=true
