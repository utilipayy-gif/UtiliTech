# Site Base URL
NEXT_PUBLIC_SITE_URL=https://www.utilitech.in

# Admin Authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Neon Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require

# --------------------------------------------------------------------------
# Airpay Payment Gateway Integration
# --------------------------------------------------------------------------
# Environment mode: 'test' for Airpay Staging / Sandbox, 'production' for Live
AIRPAY_MODE=production

# Airpay Merchant Credentials (obtained from Airpay Merchant Portal)
AIRPAY_MERCHANT_ID=371739
AIRPAY_CLIENT_ID=TRFMLE
AIRPAY_USERNAME=c7nErze3cv
AIRPAY_PASSWORD=V9DEHQ5s
AIRPAY_SECRET_KEY=2333db003a4387f11df24ad5e348fc01
AIRPAY_API_KEY=72j3enVcmWex6GT7

# Merchant Domain registered in Airpay Dashboard
AIRPAY_MERCHANT_DOMAIN=http://localhost

# Optional: Custom Gateway URL (defaults to https://payments.airpay.co.in/pay/v4/)
AIRPAY_GATEWAY_URL=https://payments.airpay.co.in/pay/v4/

# Simulation toggle (false for live Airpay gateway popup)
AIRPAY_ENABLE_SIMULATION=false
